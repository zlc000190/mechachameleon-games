# app
NEXT_PUBLIC_APP_URL = "https://mechachameleon.games"
NEXT_PUBLIC_APP_NAME = "Mecha Chameleon Games"
# Current working CDN: the public R2 managed domain for the
# `mecha-chameleon-game` bucket. To upgrade to the friendlier
# `cdn.mecchachameleon.art` URL, see docs/shared-game-cdn.md.
NEXT_PUBLIC_SHARED_GAME_URL = "https://pub-8954980549be475f97e5a9810a809587.r2.dev/index.html"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"

# database
DATABASE_PROVIDER = "sqlite"
DATABASE_URL = "file:data/local.db"
DB_SCHEMA_FILE = "./src/config/db/schema.sqlite.ts"
DB_MIGRATIONS_OUT = "./src/config/db/migrations_sqlite"
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""
